{
  "manifest_version": 3,
  "name": "Local Workbench \u2014 Selected Tabs",
  "version": "0.2.66",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "debugger",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Workbench browser access"
  },
  "optional_permissions": [
    "downloads"
  ]
}
